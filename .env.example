# EmailJS Configuration
# Get these values from https://www.emailjs.com/
PUBLIC_EMAILJS_SERVICE_ID=your_service_id_here
PUBLIC_EMAILJS_TEMPLATE_ID=your_template_id_here
PUBLIC_EMAILJS_PUBLIC_KEY=your_public_key_here

# =============================================================================
# Supabase (PostgreSQL) — this project uses Supabase only. No SQLite.
# =============================================================================
# Get these from your Supabase Project Settings -> API
PUBLIC_SUPABASE_URL=your_supabase_project_url
PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Database: use Supabase Postgres connection strings from Project Settings -> Database -> Connect
# App runtime (SvelteKit): use pooled URL (transaction mode, port 6543) to avoid connection exhaustion
DATABASE_URL="postgres://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Migrations: use direct/session URL (port 5432). Prisma CLI uses this via prisma.config.ts when DIRECT_URL is set
DIRECT_URL="postgres://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# Optional: one-time bootstrap to make a user Admin. Set to a random string, then visit
# /api/bootstrap-admin?secret=YOUR_SECRET (email defaults to alannobita21@gmail.com). Remove after use.
# BOOTSTRAP_ADMIN_SECRET=your_random_secret_here
