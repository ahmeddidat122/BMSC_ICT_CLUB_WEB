// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String
  role      String   @default("Member")
  avatar    String   @default("")
  bio       String   @default("")
  github    String   @default("")
  linkedin  String   @default("")
  createdAt DateTime @default(now())
}

model Course {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  level       String
  duration    String
  icon        String
  color       String
  topics      String   // Stored as JSON string representation for SQLite simplicity
}

model CourseProgress {
  id              Int      @id @default(autoincrement())
  userId          Int
  courseId        Int
  completedTopics String   // JSON string array of topic indices
  updatedAt       DateTime @default(now()) @updatedAt
  
  // Note: normally we'd relate these to User and Course models directly
  // but keeping it detached for minimal SQLite disruption based on existing patterns
}

model Notice {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  date        String
  type        String
  pinned      Boolean  @default(false)
}
model Project {
  id           Int      @id @default(autoincrement())
  title        String
  description  String
  image        String   // Emoji or URL
  tags         String   // JSON string array
  contributors String   // JSON string array
  status       String
  createdAt    DateTime @default(now())
}

model TeamMember {
  id        Int      @id @default(autoincrement())
  name      String
  position  String
  bio       String
  image     String   // Avatar/Headshot URL
  skills    String   // JSON string array
  socials   String   // JSON string object {facebook, linkedin, github}
  order     Int      @default(0) // Dictates display sorting on the team page
}
