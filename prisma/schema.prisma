// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema
//
// Database: Supabase (PostgreSQL only). Connection URLs are in prisma.config.ts and .env
// — no SQLite; do not switch provider to sqlite.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          Int      @id @default(autoincrement())
  email       String   @unique
  password    String
  name        String
  role        String   @default("Member")
  avatar      String   @default("")
  coverImage  String   @default("")
  bio         String   @default("")
  github      String   @default("")
  linkedin    String   @default("")
  website     String   @default("")
  xp          Int      @default(0)
  level       Int      @default(1)
  isBanned    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  badges      UserBadge[]
  activities  UserActivity[]
  discussions Discussion[]
  replies     DiscussionReply[]
}

model Badge {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String
  icon        String   // Emoji or SVG path
  color       String   @default("#0ea5e9")
  users       UserBadge[]
}

model UserBadge {
  id        Int      @id @default(autoincrement())
  userId    Int
  badgeId   Int
  user      User     @relation(fields: [userId], references: [id])
  badge     Badge    @relation(fields: [badgeId], references: [id])
  earnedAt  DateTime @default(now())

  @@unique([userId, badgeId])
}

model AuditLog {
  id          Int      @id @default(autoincrement())
  adminId     Int
  action      String   // e.g., "UPDATE_ROLE", "DELETE_PROJECT"
  targetType  String   // e.g., "User", "Project"
  targetId    Int?
  details     String   // JSON string of changes
  timestamp   DateTime @default(now())
}

model Course {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  level       String
  duration    String
  icon        String
  color       String
  topics      String   // JSON string representation
}

model CourseProgress {
  id              Int      @id @default(autoincrement())
  userId          Int
  courseId        Int
  completedTopics String   // JSON string array of topic indices
  updatedAt       DateTime @default(now()) @updatedAt
}

model Notice {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  date        String
  type        String
  pinned      Boolean  @default(false)
}

model Project {
  id           Int      @id @default(autoincrement())
  title        String
  description  String
  image        String   // Emoji or URL
  tags         String   // JSON string array
  contributors String   // JSON string array
  status       String
  createdAt    DateTime @default(now())
}

model TeamMember {
  id        Int      @id @default(autoincrement())
  name      String
  position  String
  bio       String
  image     String
  skills    String   // JSON string array
  socials   String   // JSON string object
  order     Int      @default(0)
}

model UserActivity {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  type      String   // e.g., "JOINED_PROJECT", "EARNED_BADGE"
  details   String   // JSON string
  createdAt DateTime @default(now())
}

model Discussion {
  id        Int      @id @default(autoincrement())
  title     String
  content   String
  authorId  Int
  author    User     @relation(fields: [authorId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  replies   DiscussionReply[]
}

model DiscussionReply {
  id           Int        @id @default(autoincrement())
  content      String
  authorId     Int
  discussionId Int
  author       User       @relation(fields: [authorId], references: [id])
  discussion   Discussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}
